// Helper to round position to 1/8 grid for fine control
const SNAP_GRID = GRID / 8; // 1/8 of the main grid (GRID = 22)

const snapToFineGrid = (value: number): number => {
  return Math.round(value / SNAP_GRID) * SNAP_GRID;
};

